{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "myenglish.sentence.noun_usage",
  "title": "名词用法资料（造句知识库）",
  "description": "key=spelling+pos。决定 a book / some water / two sheep / a pair of scissors 如何生成。未知不得默认 countable。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["spelling", "pos", "countability", "number_behavior", "semantic_category", "provenance"],
    "properties": {
      "spelling": { "type": "string", "pattern": "^[a-z][a-z' -]*$" },
      "pos": { "const": "n." },
      "usage_id": { "type": "string", "description": "同拼写同词性存在多用法时的区分键，如 water#liquid" },
      "countability": { "enum": ["countable", "uncountable", "both", "unknown"] },
      "number_behavior": { "enum": ["regular", "invariant", "plural_only", "collective", "mass", "unknown"] },
      "default_number": { "enum": ["singular", "plural"] },
      "indefinite_article_override": { "enum": ["a", "an", "none"], "description": "覆盖默认 a/an 规则；none=不能接不定冠词" },
      "pair_construction": { "type": "boolean", "description": "true=用 a pair of 计数（scissors/trousers）" },
      "verb_agreement": { "enum": ["singular", "plural", "both"], "description": "collective/invariant 名词的谓语一致性（police→plural, news→singular）" },
      "semantic_category": { "enum": ["person", "animal", "food", "drink", "object", "place", "time", "abstract", "event", "unknown"] },
      "notes": { "type": "string" },
      "provenance": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reviewed", "confidence", "checked_at"],
      "properties": {
        "source": { "enum": ["curated_by_agent", "spelling_rule", "imported_reference", "unknown"] },
        "reviewed": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
